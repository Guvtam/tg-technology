# Ejemplo: no guardar secretos reales en GitHub
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_WHATSAPP_VERSION=
CONTACT_WHATSAPP_PHONE_ID=
CONTACT_WHATSAPP_TOKEN=
CONTACT_WHATSAPP_RECIPIENT=
CONTACT_WHATSAPP_TEMPLATE=
CONTACT_WHATSAPP_LANGUAGE=es
